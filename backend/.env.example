# ─── MongoDB ────────────────────────────────────────────────────────────────
# Paste your Atlas connection string (replace <user>, <password>, <cluster>)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/whisperwind_grove?retryWrites=true&w=majority

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Gemini AI (optional — Half-Moon game AI mode) ──────────────────────────
# Get a free key at https://aistudio.google.com/
# When set, the "Gemini AI" mode in Half Moon is enabled.
# The key is NEVER sent to the frontend.
GEMINI_API_KEY=

# ─── ElevenLabs TTS (optional — guardian voices) ────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_ID_DEER=
ELEVENLABS_VOICE_ID_FOX=
ELEVENLABS_VOICE_ID_KODAMA=
ELEVENLABS_VOICE_ID_MONONOKE=
# Fine-tune each guardian's voice (all optional, defaults are pre-set)
ELEVENLABS_DEER_STABILITY=0.86
ELEVENLABS_FOX_STABILITY=0.28
ELEVENLABS_KODAMA_STABILITY=0.18
ELEVENLABS_MONONOKE_STABILITY=0.22
